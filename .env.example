# OpenRouter API key (required for AI features — get one at openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-...

# LLM model via OpenRouter — defaults to DeepSeek V4 Pro
LLM_MODEL=deepseek/deepseek-v4-pro
# Fast/cheap model for low-stakes utility calls (session auto-naming).
LLM_MODEL_FAST=deepseek/deepseek-chat

# Materials Project API (required for phase diagrams)
MP_API_KEY=your_mp_api_key_here

# Database (auto-configured in Docker)
DATABASE_URL=postgresql+asyncpg://leilmat:leilmat@localhost:5432/leilmat

# ChromaDB (auto-configured in Docker)
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Frontend API URL (used by Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Supabase auth (frontend + backend) ───────────────────────────────
# Project ref shared across Leil sub-apps (LeilFlowsheet, LeilStruct, LeilMat).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<from Supabase dashboard → API → anon public>

# Backend JWT validation — same secret across all Leil sub-apps.
SUPABASE_JWT_SECRET=<from Supabase dashboard → API → JWT Secret>

# ── LeilAI-5 billing API (credit header + deduction) ─────────────────
# Versioned API root.  Routes are appended without re-adding "/v1".
NEXT_PUBLIC_LEIL_API_URL=https://www.leil.app/api/v1
LEIL_AGENT_URL=https://www.leil.app/api/v1
LEIL_SERVICE_TOKEN=<issued by LeilAI-5 once Phase 0a is deployed; blank = no-op>

# LeilMat's own backend URL (for frontend → backend calls).
NEXT_PUBLIC_LEILMAT_API_URL=http://localhost:8000
