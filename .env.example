# OpenRouter API key (required for AI features — get one at openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-...

# LLM model via OpenRouter — defaults to DeepSeek V4 Pro
LLM_MODEL=deepseek/deepseek-v4-pro
# Fast/cheap model for low-stakes utility calls (session auto-naming).
LLM_MODEL_FAST=deepseek/deepseek-chat

# Materials Project API (required for phase diagrams)
MP_API_KEY=your_mp_api_key_here

# Database (auto-configured in Docker)
DATABASE_URL=postgresql+asyncpg://leilmat:leilmat@localhost:5432/leilmat

# ChromaDB (auto-configured in Docker)
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Frontend API URL (used by Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ══ Optional integrations ═════════════════════════════════════════════
# Everything below is OFF unless uncommented.  Leave it commented for local
# development: the API then runs without authentication or billing.
#
# SECURITY: with neither SUPABASE_JWT_SECRET nor SUPABASE_URL set, the API
# allows gated endpoints unauthenticated ("soft mode", logged as a warning).
# Never expose an instance configured that way to an untrusted network.

# ── Supabase auth (frontend + backend) — create your OWN project ─────
# SUPABASE_URL=https://<your-project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<Supabase dashboard → API → anon public>
# SUPABASE_JWT_SECRET=<Supabase dashboard → API → JWT Secret>

# ── Credit / billing service (hosted-deployment integration) ─────────
# Only meaningful if you run a compatible billing backend.  Blank = no-op.
# NEXT_PUBLIC_LEIL_API_URL=
# LEIL_AGENT_URL=
# LEIL_SERVICE_TOKEN=

# ── Cloud simulations (Daytona sandboxes: Neper / SPPARKS / DAMASK) ──
# DAYTONA_API_KEY=
# DAYTONA_SNAPSHOT_NEPER=
# DAYTONA_SNAPSHOT_SPPARKS=
# DAYTONA_SNAPSHOT_DAMASK=

# ── Job-complete email (Mailtrap) ────────────────────────────────────
# MAILTRAP_API_TOKEN=
# MAILTRAP_SENDER_EMAIL=you@your-verified-domain.example

# ── Deployment identity ──────────────────────────────────────────────
# Browser origins allowed to call the API with credentials (comma-separated).
# Defaults to local development only.  Set this for any real deployment.
# CORS_ORIGINS=https://app.example.org
# Public URL: used for links in emails and as the domain in PDF report footers.
# PUBLIC_APP_URL=https://app.example.org

# LeilMat's own backend URL (for frontend → backend calls).
NEXT_PUBLIC_LEILMAT_API_URL=http://localhost:8000
